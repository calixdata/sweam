<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets" xmlns:tizen="http://tizen.org/ns/widgets" id="http://sweam.co/tv" version="0.1.0" viewmodes="maximized">
  <tizen:application id="SweamTVapp.SweamTV" package="SweamTVapp" required_version="6.0" />
  <!-- Thin shell: the TV app itself is hosted at tv.sweam.co, so store updates
       never require a repackage. index.html redirects there. -->
  <content src="index.html" />
  <icon src="icon.png" />
  <name>SweamTV</name>
  <access origin="https://sweam.co" subdomains="true" />
  <feature name="http://tizen.org/feature/network.internet" />
  <tizen:privilege name="http://tizen.org/privilege/internet" />
  <tizen:profile name="tv" />
  <tizen:setting screen-orientation="landscape" context-menu="disable" background-support="disable" encryption="disable" install-location="auto" hwkey-event="enable" />
</widget>
