{
  "expo": {
    "name": "Sweam",
    "slug": "sweam",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "sweam",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#080e19",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "co.sweam.app",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryAddUsageDescription": "Sweam saves clips you choose to keep to your library."
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "co.sweam.app",
      "versionCode": 4,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#1759F5",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-video",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Sweam uses your camera so you can record and post clips.",
          "microphonePermission": "Sweam uses your microphone to record sound with your clips.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Sweam needs access to your library so you can post a video you already have."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#1759F5"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1759F5",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "privacy": "public",
    "description": "Sweam: where TikTok meets Tubi. Creator-made films, series and clips with equal visibility, scouted by networks.",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4acae0d1-da29-4922-800b-b1bf1c850674"
      }
    },
    "owner": "sweam"
  }
}
