{
  "expo": {
    "name": "Sweam",
    "slug": "sweam",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "sweam",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#080e19",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "co.sweam.app"
    },
    "android": {
      "package": "co.sweam.app",
      "versionCode": 1,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#080e19",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-video",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Sweam uses your camera so you can record and post clips.",
          "microphonePermission": "Sweam uses your microphone to record sound with your clips.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Sweam needs access to your library so you can post a video you already have."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#4de0f3"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#080e19",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
