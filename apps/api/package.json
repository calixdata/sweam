{
  "name": "@sweam/api",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Sweam API: Cloudflare Worker serving the catalog, discovery ranking, auth, studio, and media byte-range streaming.",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "wrangler d1 migrations apply sweam-db --local",
    "db:seed": "wrangler d1 execute sweam-db --local --file seed.sql",
    "db:migrate:remote": "wrangler d1 migrations apply sweam-db --remote",
    "db:seed:remote": "wrangler d1 execute sweam-db --remote --file seed.sql"
  },
  "dependencies": {
    "@sweam/shared": "0.3.0",
    "hono": "^4.6.15",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250801.0",
    "vitest": "^3.0.0",
    "wrangler": "^4.0.0"
  }
}
